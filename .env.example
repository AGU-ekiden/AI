# 特徴量ラボ 環境変数見本（秘密値は書かないこと。実ファイル .env はgit管理外）
# ローカルWebのアクセストークン。未設定なら起動時に data/.token へ生成（0600）。
LABO_TOKEN=
# 待受アドレス。既定は 127.0.0.1（外部公開しない）。
LABO_HOST=127.0.0.1
LABO_PORT=8765
# 保存先（ファイル保存）。既定 ./data
LABO_DATA_DIR=./data
# --- 段階2（承認後のみ）：読み取り専用接続。値は安全な秘密管理から注入する ---
# RKM_READONLY_DSN=postgresql://<readonly_user>@<host>:5432/postgres?sslmode=require
# RKM_STATEMENT_TIMEOUT_MS=15000
# --- AI相談（段階4・既定無効）。実データ送信は既定で禁止 ---
# LABO_AI_ENABLED=false
# LABO_AI_ALLOW_REAL_DATA=false
