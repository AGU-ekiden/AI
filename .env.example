# 特徴量ラボ 環境変数見本（秘密値は書かないこと。実ファイル .env はgit管理外）
# 利用者は data/users.json（トークンはハッシュのみ保存）。初回起動時に管理者を作成し data/.token へ。
# メンバー追加: python3 -m labo.users add --name 氏名 --role editor|viewer|admin
# HTTPS の内側で運用する場合は true（Cookie に Secure を付与）
LABO_SECURE_COOKIE=false
# 利用者定義の「計算可能／研究で採用」を作成者以外が承認する（相互確認）
LABO_REQUIRE_SECOND_REVIEWER=true
# 待受アドレス。既定は 127.0.0.1（外部公開しない）。
LABO_HOST=127.0.0.1
LABO_PORT=8765
# 保存先（ファイル保存）。既定 ./data
LABO_DATA_DIR=./data
# --- 段階2（承認後のみ）：読み取り専用接続。値は安全な秘密管理から注入する ---
# 推奨構成は docs/supabase_setup.sql（lab_reader / lab_writer ロール）
# RKM_READONLY_DSN=postgresql://lab_reader:<password>@<host>:5432/postgres?sslmode=require
# LAB_WRITER_DSN=postgresql://lab_writer:<password>@<host>:5432/postgres?sslmode=require
# RKM_STATEMENT_TIMEOUT_MS=15000
# --- AI相談（段階4・既定無効）。実データ送信は既定で禁止 ---
# LABO_AI_ENABLED=false
# LABO_AI_ALLOW_REAL_DATA=false
